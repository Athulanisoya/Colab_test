# Ollama uses a local OpenAI-compatible endpoint; no OpenAI key is needed.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=resq-gemma4
AI_TIMEOUT_SECONDS=180
# SQLite supports a standalone local demo. Compose uses PostgreSQL.
DATABASE_URL=sqlite:///./data/resq.db
DEMO_MODE=true
# Replace this before sharing the application beyond your own machine.
JWT_SECRET=local-resq-development-only-change-before-deployment-2026
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Password recovery: leave empty for the private administrator demo mailbox.
# See docs/api_documentation.md for Brevo setup. Never commit real secrets.
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
# offline: receipt verification; sandbox: local TEST simulation (demo only).
# razorpay: provider checkout, requires locally configured credentials.
PAYMENT_PROVIDER=offline
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional consented public-landmark geocoding; local gazetteer works offline.
RESQ_GEOCODING_ENABLED=true
